{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-os-2-staging",
  "account_id": "2b21a330cb23ad0163a2941035b859e4",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "561363942798-9mstg6gobqokq0iobdq36s5lh441j3ah.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-os-2-staging-db",
      "database_id": "740312bc-bd1f-4d69-826f-d31208789598",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "work-os-staging-files" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "OWNER_CHANNEL", "class_name": "OwnerChannel" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OwnerChannel"] }
  ],
  "env": {
    "production": {
      "name": "work-os-2",
      "vars": {
        "GOOGLE_CLIENT_ID": "561363942798-9mstg6gobqokq0iobdq36s5lh441j3ah.apps.googleusercontent.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "work-os-production",
          "database_id": "dbe3fce7-5c0c-4ae4-9497-dc236a4e8141",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "OWNER_CHANNEL", "class_name": "OwnerChannel" }
        ]
      }
    },
    // Публічна демо-версія з вигаданими даними: окремий воркер і окрема база, без R2, Google і секретів.
    // Нульовий database_id — заглушка для збірки й локального запуску; `npm run deploy:demo` підставляє справжній id бази
    // `work-os-demo-db` (створює її, якщо немає) і відмовляється розгортати із заглушкою.
    "demo": {
      "name": "work-os-demo",
      "vars": { "DEMO_MODE": "1" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "work-os-demo-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "OWNER_CHANNEL", "class_name": "OwnerChannel" },
          { "name": "DEMO_GUARD", "class_name": "DemoGuard" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["OwnerChannel", "DemoGuard"] }
      ],
      "triggers": { "crons": ["0 0 * * *"] },
      "observability": { "enabled": false }
    }
  }
}
